{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=IES_Dev;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "Secret": "DEV_SECRET_DO_NOT_USE_IN_PROD_1234567890_LONG_ENOUGH",
    "Issuer": "IES.api",
    "Audience": "IES.client",
    "ExpiryInHours": 24
  },
  "AiService": {
    "BaseUrl": "http://localhost:8000"
  },
  "FileStorage": {
    "BasePath": "Uploads",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [".pdf", ".docx"]
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "your-email@gmail.com",
    "SenderPassword": "your-app-password",
    "SenderName": "IES Platform"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200",
      "http://localhost:64865",
      "https://localhost:64865"
    ]
  },
  "ForwardedHeaders": {
    "KnownProxies": [
      "127.0.0.1"
    ]
  }
}
