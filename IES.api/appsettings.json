{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=IES_Prod;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "Secret": "YourSuperSecretKey_AtLeast32Characters!",
    "Issuer": "IES.api",
    "Audience": "IES.client",
    "ExpiryInHours": 24
  },
  "AiService": {
    "BaseUrl": "http://localhost:8000"
  },
  "FileStorage": {
    "BasePath": "Uploads",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [".pdf", ".docx"]
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "your-email@gmail.com",
    "SenderPassword": "your-app-password",
    "SenderName": "IES Platform"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  }
}
