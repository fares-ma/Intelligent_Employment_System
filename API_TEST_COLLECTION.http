  "location": "Riyadh, Saudi Arabia",
  "startDate": "2015-01-15",
  "endDate": "2023-12-31",
  "currentlyWorking": false,
  "description": "Led development team of 5 engineers"
}

### 4.4 Update Experience Record
PUT {{baseUrl}}/experience/experience-id-456
Authorization: Bearer {{candidateToken}}
Content-Type: {{contentType}}

{
  "jobTitle": "Lead Software Engineer",
  "company": "Tech Solutions Inc",
  "location": "Riyadh, Saudi Arabia",
  "startDate": "2015-01-15",
  "endDate": "2023-12-31",
  "currentlyWorking": false,
  "description": "Led development team of 8 engineers"
}

### 4.5 Delete Experience Record
DELETE {{baseUrl}}/experience/experience-id-456
Authorization: Bearer {{candidateToken}}

# ============================================
# 5. SKILL MANAGEMENT TESTS
# ============================================

### 5.1 Get All Skills
GET {{baseUrl}}/skill
Authorization: Bearer {{candidateToken}}

### 5.2 Get Specific Skill
GET {{baseUrl}}/skill/skill-id-789
Authorization: Bearer {{candidateToken}}

### 5.3 Add Skill
POST {{baseUrl}}/skill
Authorization: Bearer {{candidateToken}}
Content-Type: {{contentType}}

{
  "skillName": "C#",
  "level": 3
}

### 5.4 Update Skill Level
PUT {{baseUrl}}/skill/skill-id-789
Authorization: Bearer {{candidateToken}}
Content-Type: {{contentType}}

{
  "level": 2
}

### 5.5 Delete Skill
DELETE {{baseUrl}}/skill/skill-id-789
Authorization: Bearer {{candidateToken}}

### 5.6 Get Skills by Level
GET {{baseUrl}}/skill/level/3
Authorization: Bearer {{candidateToken}}

# ============================================
# 6. JOB POSTING TESTS
# ============================================

### 6.1 Get All Active Job Postings (Paginated)
GET {{baseUrl}}/jobposting?pageNumber=1&pageSize=10

### 6.2 Get Specific Job Posting
GET {{baseUrl}}/jobposting/1

### 6.3 Create Job Posting (Recruiter only)
POST {{baseUrl}}/jobposting
Authorization: Bearer {{recruiterToken}}
Content-Type: {{contentType}}

{
  "title": "Senior Frontend Developer",
  "description": "We are looking for an experienced frontend developer with React expertise",
  "salary": 150000,
  "applicationDeadline": "2026-04-30",
  "requiredSkillIds": [1, 2, 3]
}

### 6.4 Update Job Posting
PUT {{baseUrl}}/jobposting/1
Authorization: Bearer {{recruiterToken}}
Content-Type: {{contentType}}

{
  "title": "Senior Frontend Developer (Updated)",
  "description": "Updated description",
  "salary": 160000,
  "applicationDeadline": "2026-05-31",
  "isActive": true,
  "requiredSkillIds": [1, 2, 3, 4]
}

### 6.5 Delete Job Posting
DELETE {{baseUrl}}/jobposting/1
Authorization: Bearer {{recruiterToken}}

### 6.6 Search Job Postings
GET {{baseUrl}}/jobposting/search/developer?pageNumber=1&pageSize=10

### 6.7 Filter by Skill
GET {{baseUrl}}/jobposting/skill/1?pageNumber=1&pageSize=10

### 6.8 Filter by Employment Type
GET {{baseUrl}}/jobposting/type/Full-Time?pageNumber=1&pageSize=10

# ============================================
# 7. JOB APPLICATION TESTS
# ============================================

### 7.1 Submit Job Application (Candidate only)
POST {{baseUrl}}/jobapplication/apply
Authorization: Bearer {{candidateToken}}
Content-Type: {{contentType}}

{
  "jobPostId": 1,
  "resumeId": "resume-id-123"
}

### 7.2 Get Application Details
GET {{baseUrl}}/jobapplication/1
Authorization: Bearer {{candidateToken}}

### 7.3 Get Candidate's Applications
GET {{baseUrl}}/jobapplication/candidate/candidate-id

### 7.4 Get Applications for Job Posting (Recruiter only)
GET {{baseUrl}}/jobapplication/job/1
Authorization: Bearer {{recruiterToken}}

### 7.5 Update Application Status (Recruiter only)
PATCH {{baseUrl}}/jobapplication/1/status
Authorization: Bearer {{recruiterToken}}
Content-Type: {{contentType}}

{
  "status": "Accepted"
}

# ============================================
# 8. INTERVIEW MANAGEMENT TESTS
# ============================================

### 8.1 Schedule Interview (Recruiter only)
POST {{baseUrl}}/interview
Authorization: Bearer {{recruiterToken}}
Content-Type: {{contentType}}

{
  "jobApplicationId": 1,
  "interviewType": "Technical",
  "scheduledAt": "2026-04-15T10:00:00Z",
  "durationMinutes": 60,
  "meetingLink": "https://zoom.us/meeting/123456"
}

### 8.2 Get Interview Details
GET {{baseUrl}}/interview/1
Authorization: Bearer {{recruiterToken}}

### 8.3 Get Interviews for Application
GET {{baseUrl}}/interview/application/1
Authorization: Bearer {{recruiterToken}}

### 8.4 Get Candidate's Interviews
GET {{baseUrl}}/interview/candidate/candidate-id?pageNumber=1&pageSize=10
Authorization: Bearer {{candidateToken}}

### 8.5 Get Recruiter's Interviews
GET {{baseUrl}}/interview/recruiter/interviews?pageNumber=1&pageSize=10
Authorization: Bearer {{recruiterToken}}

### 8.6 Update Interview Details
PUT {{baseUrl}}/interview/1
Authorization: Bearer {{recruiterToken}}
Content-Type: {{contentType}}

{
  "status": "Completed",
  "aiTranscript": "Interview transcript...",
  "score": 85,
  "feedbackNotes": "Strong technical skills"
}

### 8.7 Cancel Interview
DELETE {{baseUrl}}/interview/1
Authorization: Bearer {{recruiterToken}}

### 8.8 Get Interviews by Status
GET {{baseUrl}}/interview/status/Scheduled?pageNumber=1&pageSize=10
Authorization: Bearer {{recruiterToken}}

# ============================================
# 9. CANDIDATE PROFILE TESTS
# ============================================

### 9.1 Get Candidate Profile
GET {{baseUrl}}/candidates/candidate-id
Authorization: Bearer {{candidateToken}}

### 9.2 Update Candidate Profile
PUT {{baseUrl}}/candidates/candidate-id
Authorization: Bearer {{candidateToken}}
Content-Type: {{contentType}}

{
  "firstName": "Updated",
  "lastName": "Name",
  "phoneNumber": "+966599999999",
  "bio": "Passionate software developer"
}

### 9.3 Get Candidate's Saved Jobs
GET {{baseUrl}}/candidates/candidate-id/saved-jobs
Authorization: Bearer {{candidateToken}}

### 9.4 Get Candidate's Applications
GET {{baseUrl}}/candidates/candidate-id/applications
Authorization: Bearer {{candidateToken}}

# ============================================
# 10. ERROR SCENARIOS & EDGE CASES
# ============================================

### 10.1 Access Protected Resource Without Token
GET {{baseUrl}}/education
# Should return 401 Unauthorized

### 10.2 Access with Invalid Token
GET {{baseUrl}}/education
Authorization: Bearer invalid-token-12345

### 10.3 Register with Duplicate Email
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "email": "candidate.test@example.com",
  "password": "SecurePass123!",
  "firstName": "Duplicate",
  "lastName": "User",
  "phoneNumber": "+966501234567",
  "gender": "Male",
  "dateOfBirth": "1990-01-15"
}
# Should return 409 Conflict

### 10.4 Login with Invalid Password
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "candidate.test@example.com",
  "password": "WrongPassword123!"
}
# Should return 401 Unauthorized

### 10.5 Access Recruiter Endpoint as Candidate
POST {{baseUrl}}/jobposting
Authorization: Bearer {{candidateToken}}
Content-Type: {{contentType}}

{
  "title": "Job Title",
  "description": "Description",
  "salary": 100000,
  "applicationDeadline": "2026-04-30",
  "requiredSkillIds": [1]
}
# Should return 403 Forbidden

### 10.6 Skill Level Out of Range
POST {{baseUrl}}/skill
Authorization: Bearer {{candidateToken}}
Content-Type: {{contentType}}

{
  "skillName": "JavaScript",
  "level": 5
}
# Should return 400 Bad Request (level must be 1-3)

### 10.7 Invalid Pagination Parameters
GET {{baseUrl}}/jobposting?pageNumber=-1&pageSize=1000
# Should return 400 Bad Request

### 10.8 Access Non-existent Resource
GET {{baseUrl}}/jobposting/99999
# Should return 404 Not Found

### 10.9 Update Non-existent Resource
PUT {{baseUrl}}/education/non-existent-id
Authorization: Bearer {{candidateToken}}
Content-Type: {{contentType}}

{
  "schoolName": "University",
  "degree": "Bachelor",
  "fieldOfStudy": "CS"
}
# Should return 404 Not Found

### 10.10 Register with Weak Password
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "email": "weak.pass@example.com",
  "password": "weak",
  "firstName": "Test",
  "lastName": "User",
  "phoneNumber": "+966501234567",
  "gender": "Male",
  "dateOfBirth": "1990-01-15"
}
# Should return 400 Bad Request
