### Intelligent Employment System - Complete API Tests
### Base URL: http://localhost:5000/api

# ============================================
# 1. AUTHENTICATION & REGISTRATION TESTS
# ============================================

@baseUrl = http://localhost:5000/api
@contentType = application/json

### 1.1 Register as Candidate
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "email": "candidate.test@example.com",
  "password": "SecurePass123!",
  "firstName": "Test",
  "lastName": "Candidate",
  "phoneNumber": "+966501234567",
  "gender": "Male",
  "dateOfBirth": "1990-01-15"
}

### 1.2 Register Company with Admin Recruiter
POST {{baseUrl}}/auth/register/company
Content-Type: {{contentType}}

{
  "email": "admin.recruiter@example.com",
  "password": "SecurePass123!",
  "firstName": "Admin",
  "lastName": "Recruiter",
  "phoneNumber": "+966502345678",
  "gender": "Female",
  "dateOfBirth": "1985-05-20",
  "companyName": "Tech Solutions Inc",
  "taxNumber": "1234567890",
  "industry": "Technology",
  "website": "https://techsolutions.com"
}

### 1.3 Generate Invite Code (for registering standard recruiters)
# This would be done by admin through the system
# For now, assume invite code exists: INVITE123

### 1.4 Register Standard Recruiter with Invite Code
POST {{baseUrl}}/auth/register/recruiter
Content-Type: {{contentType}}

{
  "email": "recruiter.test@example.com",
  "password": "SecurePass123!",
  "firstName": "Standard",
  "lastName": "Recruiter",
  "phoneNumber": "+966503456789",
  "gender": "Male",
  "dateOfBirth": "1988-03-10",
  "inviteCode": "INVITE123"
}

### 1.5 Login as Candidate
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "candidate.test@example.com",
  "password": "SecurePass123!"
}

@candidateToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

### 1.6 Login as Admin Recruiter
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "admin.recruiter@example.com",
  "password": "SecurePass123!"
}

@recruiterToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

### 1.7 Logout
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{candidateToken}}

### 1.8 Forgot Password
POST {{baseUrl}}/auth/forgot-password
Content-Type: {{contentType}}

{
  "email": "candidate.test@example.com"
}

### 1.9 Reset Password
POST {{baseUrl}}/auth/reset-password
Content-Type: {{contentType}}

{
  "email": "candidate.test@example.com",
  "resetToken": "token-from-email",
  "newPassword": "NewSecurePass123!"
}

# ============================================
# 2. COMPANY MANAGEMENT TESTS
# ============================================

### 2.1 Get Company Profile
GET {{baseUrl}}/company/1
Authorization: Bearer {{recruiterToken}}

### 2.2 Update Company Profile
PUT {{baseUrl}}/company/1
Authorization: Bearer {{recruiterToken}}
Content-Type: {{contentType}}

{
  "name": "Tech Solutions Updated",
  "industry": "Software Development",
  "website": "https://updated-techsolutions.com",
  "description": "Leading software development company"
}

### 2.3 Transfer Admin Role
POST {{baseUrl}}/company/1/admin/transfer
Authorization: Bearer {{recruiterToken}}
Content-Type: {{contentType}}

{
  "newAdminId": "recruiter-user-id"
}

### 2.4 Get Active Invite Codes
GET {{baseUrl}}/company/1/invitations/active
Authorization: Bearer {{recruiterToken}}

# ============================================
# 3. EDUCATION MANAGEMENT TESTS
# ============================================

### 3.1 Get All Education Records
GET {{baseUrl}}/education
Authorization: Bearer {{candidateToken}}

### 3.2 Get Specific Education Record
GET {{baseUrl}}/education/education-id-123
Authorization: Bearer {{candidateToken}}

### 3.3 Add Education Record
POST {{baseUrl}}/education
Authorization: Bearer {{candidateToken}}
Content-Type: {{contentType}}

{
  "schoolName": "King Saud University",
  "degree": "Bachelor",
  "fieldOfStudy": "Computer Science",
  "startDate": "2008-09-01",
  "endDate": "2012-06-30",
  "description": "Graduated with distinction"
}

### 3.4 Update Education Record
PUT {{baseUrl}}/education/education-id-123
Authorization: Bearer {{candidateToken}}
Content-Type: {{contentType}}

{
  "schoolName": "King Saud University",
  "degree": "Bachelor",
  "fieldOfStudy": "Computer Science",
  "startDate": "2008-09-01",
  "endDate": "2012-06-30",
  "description": "Updated description"
}

### 3.5 Delete Education Record
DELETE {{baseUrl}}/education/education-id-123
Authorization: Bearer {{candidateToken}}

# ============================================
# 4. EXPERIENCE MANAGEMENT TESTS
